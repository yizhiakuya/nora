# dependencies (fallback, normally each subproject has its own)
node_modules/

# IDE-specific
.claude/

# assistant workspace memory (local only)
.workbuddy/
.workbuddy-ai/

# misc
.DS_Store
*.pem

# local env files
.env*.local

# service run logs (dev)
*.log

# upstream debugging captures (local only)
/hy3_*.json
/hy3_*.txt
/enc_*.json
/.playwright-mcp/

# runtime file logs (logback)
logs/

# phone-album MCP local tokens (never commit)
scripts/.phone-mcp-token
scripts/.phone-mcp-token-read

# agent workspace (private memory: user prefs / agent notes — back up separately)
agent-workspace/

# bundled pwsh runtime (extracted cache; the archive itself is tracked via git-lfs)
tools/pwsh/pwsh-*/
# 临时提交消息文件（写多行中文提交信息用，不属于仓库内容）
scripts/_cm.txt

# 卸载/迁移的本地数据存档（含私有对话与工作区记忆，仅存本地，绝不上远程）
archive/
