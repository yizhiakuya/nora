# Nora 部署配置(复制为 .env 后按需修改;docker compose 自动读取)
# 用法:cp .env.example .env && docker compose -f docker-compose.prod.yml up -d

# ---------- 镜像 ----------
# 镜像 tag(latest / 具体版本如 v1.2.0 / 提交 sha)
NORA_TAG=latest

# ---------- 端口(宿主机映射;基础设施仅限 127.0.0.1,冲突时改这里) ----------
GATEWAY_PORT=18080
WEB_PORT=13001
POSTGRES_PORT=15432
REDIS_PORT=16379
NACOS_PORT=18848

# ---------- 数据库 ----------
DB_USER=nora
# 必填:设置独立的强密码;已有数据卷需同步修改数据库用户密码。
DB_PASSWORD=

# ---------- 访问令牌(网关鉴权;留空 = 免登录,公网暴露务必设置) ----------
NORA_AUTH_TOKEN=

# ---------- 模型接入 ----------
# LLM:启动后在「设置 → 模型」里添加服务商(数据库为唯一配置来源,无环境变量兜底)
# 嵌入(Jina v3;知识库功能需要)
NORA_EMBEDDING_API_KEY=
NORA_EMBEDDING_BASE_URL=https://api.jina.ai/v1

# ---------- 出站代理(可选;外网访问受限时配置) ----------
NORA_PROXY_ENABLED=false
NORA_PROXY_HOST=
NORA_PROXY_PORT=

# ---------- 容器管理(可选) ----------
# env-service 管理宿主机 Docker 需要挂载 /var/run/docker.sock(默认不挂载,保持安全)
# NORA_DOCKER_HOST=unix:///var/run/docker.sock
