<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nora</groupId>
        <artifactId>nora-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>nora-common</artifactId>
    <packaging>jar</packaging>
    <name>nora :: common :: nora-common</name>
    <description>Nora shared library: unified ApiResponse envelope, BusinessException, and global REST exception handling</description>

    <dependencies>
        <!-- Only spring-boot-starter (core + Jackson) at compile scope; web is provided so the
             @RestControllerAdvice compiles without dragging Tomcat into every consumer. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 结构化 JSON 日志编码器:由 common 引入,全部服务经传递依赖获得 -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>

        <!-- Redis 客户端(Lettuce):共享 NoraRedis 门面编译用;
             运行时由真正启用 Redis 的服务自带(provided 不传递),未引入的服务
             自动装配条件不满足、NoraRedis 不会被加载 -->
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Kafka 客户端:共享 NotificationPublisher 门面编译用(2026-09-19 通知事件总线);
             运行时由作为 producer 的服务自带(provided 不传递)——未引入 kafka-clients
             的服务自动装配条件不满足、发布门面不会被加载 -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
