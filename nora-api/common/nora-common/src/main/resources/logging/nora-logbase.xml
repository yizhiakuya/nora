<?xml version="1.0" encoding="UTF-8"?>
<!--
  nora 全服务日志基座(各服务 logback-spring.xml include 本文件):
  - CONSOLE:人读格式(开发时看控制台),含 traceId
  - JSON_FILE:logstash-logback-encoder JSON 行,滚动文件,排障/采集主出口——
    traceId/sessionId/turnId 落为独立字段,jq 'select(.traceId=="…")' 直接检索
  - ASYNC_JSON:异步包装,流式读取线程不因磁盘 IO 阻塞(neverBlock:宁丢不堵)
  滚动策略:单文件 20MB,保留 7 天/20 个,总量上限 500MB,按服务名分文件。
  服务日志目录:LOG_PATH 环境变量,缺省 D:/claude/Nora/logs(与既有约定一致)。
-->
<included>

  <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_PATH:-D:/claude/Nora/logs}/${SERVICE_NAME}.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_PATH:-D:/claude/Nora/logs}/${SERVICE_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>20MB</maxFileSize>
      <maxHistory>7</maxHistory>
      <totalSizeCap>500MB</totalSizeCap>
    </rollingPolicy>
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <customFields>{"service":"${SERVICE_NAME}"}</customFields>
      <fieldNames>
        <version>[ignore]</version>
      </fieldNames>
      <timeZone>Asia/Shanghai</timeZone>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- 旧人读文本文件日志:保留(与 JSON 并行),人工 tail 场景仍顺手 -->
  <appender name="TEXT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_PATH:-D:/claude/Nora/logs}/${SERVICE_NAME}-text.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_PATH:-D:/claude/Nora/logs}/${SERVICE_NAME}-text.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>20MB</maxFileSize>
      <maxHistory>7</maxHistory>
      <totalSizeCap>500MB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS} %level [${SERVICE_NAME}] [trace=%X{traceId:-} sess=%X{sessionId:-}] %logger{24} : %msg%n%ex{full}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- 异步包装(排队 4096,队列满直接丢弃并计数,不阻塞业务线程) -->
  <appender name="ASYNC_JSON" class="ch.qos.logback.classic.AsyncAppender">
    <queueSize>4096</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <neverBlock>true</neverBlock>
    <appender-ref ref="JSON_FILE"/>
  </appender>
  <appender name="ASYNC_TEXT" class="ch.qos.logback.classic.AsyncAppender">
    <queueSize>4096</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <neverBlock>true</neverBlock>
    <appender-ref ref="TEXT_FILE"/>
  </appender>

</included>
